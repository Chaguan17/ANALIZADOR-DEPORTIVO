# ── ANALIZADOR DEPORTIVO — plantilla de variables de entorno ──────────────
# Copia este archivo como ".env" y rellena los valores.
# REGLA DEL PROYECTO: el archivo .env real NUNCA se sube a GitHub (ver .gitignore).

# Clave de la API de football-data.org
# Regístrate gratis en: https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# Cadena de conexión a Postgres LOCAL (servicio "db" de docker-compose)
DATABASE_URL=postgresql+psycopg://analizador:devpassword@localhost:5432/analizador

# Frontend: ¿a qué API hablar? (se llena en la Fase 9; en local usa el backend dockerizado)
# NEXT_PUBLIC_API_URL=http://localhost:8000
